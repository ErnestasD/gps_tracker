exports[`E03-5 AC[3]: branded email layout > renders tenant name, logo and accent color 1`] = `"<!doctype html><html lang="en" style="color-scheme:light;supported-color-schemes:light"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="color-scheme" content="light" /><meta name="supported-color-schemes" content="light" /><title>Alert</title></head><body style="margin:0;padding:0;background:#f1f5f9;-webkit-font-smoothing:antialiased"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f1f5f9"><tr><td align="center" style="padding:32px 16px"><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px"><tr><td style="padding:0 0 20px"><img src="https://cdn.acme.test/logo.png" alt="Acme Track" height="28" style="height:28px;display:block;border:0" /></td></tr><tr><td><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;border:1px solid #e2e8f0;border-radius:14px"><tr><td style="height:4px;background:#ff8800;border-radius:14px 14px 0 0;line-height:4px;font-size:0">&nbsp;</td></tr><tr><td style="padding:32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Arial,sans-serif;color:#0f172a;font-size:15px;line-height:1.6"><p>Your device moved.</p></td></tr></table></td></tr><tr><td style="padding:20px 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,Arial,sans-serif;color:#94a3b8;font-size:12px;line-height:1.6"><p style="margin:0 0 4px">Acme Track · <a href="mailto:help@acme.test" style="color:#94a3b8;text-decoration:underline">help@acme.test</a></p><p style="margin:0">You received this because someone used this address on our service. It is a one-off message about your account, not marketing.</p></td></tr></table></td></tr></table></body></html>"`;
