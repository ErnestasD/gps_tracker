# Orbetra reverse proxy (E01-2, E03-5). Tenant custom domains get automatic HTTPS
# via on-demand TLS: Caddy asks the api before minting a cert, so a cert is only
# ever issued for a domain a tenant has verified (DNS TXT). An unreachable ask
# endpoint = deny, so a broken api never leaks certs for arbitrary hostnames.
{
	on_demand_tls {
		ask http://api:3010/v1/internal/caddy-ask
		# Caddy ≥2.8 dropped interval/burst here (ask throttling is internal now);
		# our api-side per-domain rate limit (E03-5) remains the real gate
	}
}

# Local/dev default: plain HTTP on :80 with health endpoint.
:80 {
	# `-Server` here too: this block answers any Host that reached :80 without matching a named
	# site — including a tenant's custom domain over plain HTTP — and it was the one place in the
	# file still returning `Server: Caddy`.
	header -Server
	respond /healthz "ok" 200
	# app routes are wired in E02+ stories (api, web); keep 404 for everything else
	respond 404
}

# ── Production hosts (W9-S1): orbetra.com = public site, dash.orbetra.com = app ──
# Both env-gated: unset defaults are unresolvable, so these blocks are inert locally.
# Caddy mints Let's Encrypt certs automatically once DNS points here (ports 80/443 open).
{$ORBETRA_SITE_HOST:site-host.invalid}, {$ORBETRA_SITE_WWW:www-host.invalid} {
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	@www host {$ORBETRA_SITE_WWW:www-host.invalid}
	redir @www https://{$ORBETRA_SITE_HOST:site-host.invalid}{uri} permanent
	# least privilege (review LOW): the site only needs the PUBLIC pilot endpoint — not the
	# whole /v1 surface (login brute-force, caddy-ask, docs). Cap the unauthenticated body
	# at 64 KB (review MED: the only public write must not buffer multi-MB POSTs).
	handle /v1/public/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:3010
	}
	# …and the PARTNER PORTAL, which lives on this host and nowhere else. It was added in W9 and
	# this carve-out was never widened, so every call it makes — login, me, commissions,
	# set-password — fell through to the SPA and answered 404. The portal has therefore never
	# worked in production: a partner who followed their invite link could not sign in at all.
	# It stays OFF the tenant blocks (they 404 it deliberately): the affiliate programme is ours,
	# not a reseller's, and must not be reachable on their domain.
	handle /v1/partner/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy api:3010
	}
	# static SPA (vite preview serving the built dist — same tested path as the app)
	handle {
		reverse_proxy site:4174
	}
}

{$ORBETRA_APP_HOST:app-host.invalid} {
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# INTERNAL-ONLY: /v1/internal/* (the on-demand-TLS ask) is called by Caddy over the compose
	# network and must never be reachable from the internet. It is unauthenticated by design, and
	# its throttle is keyed on the REQUESTED DOMAIN — which turned it into an anonymous kill-switch:
	# 10 requests/min for someone else's white-label hostname makes the ask return 429, Caddy reads
	# any non-2xx as "deny", and that tenant's certificate stops being issued or renewed. The 200/403
	# split is also an unauthenticated oracle for which hostnames are verified. Audit high.
	handle /v1/internal/* {
		respond 404
	}
	handle /v1/* {
		# /v1/* includes the WS upgrade at /v1/stream — the API rejects any other /ws path
		reverse_proxy api:3010
	}
	handle {
		reverse_proxy web:5173
	}
}

# ── Staging over plain HTTP by IP (W7-D, until DNS/TLS lands) ────────────────
# Served only when the request Host matches ORBETRA_STAGING_HOST (set in the server's
# .env, e.g. 185.80.129.33). The default is an unresolvable name, so this block is
# inert locally. Same routing as the HTTPS block below; drop this once real DNS + TLS
# are live.
http://{$ORBETRA_STAGING_HOST:staging-host.invalid} {
	# same edge headers as the HTTPS block, minus HSTS (no TLS here yet)
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# INTERNAL-ONLY: /v1/internal/* (the on-demand-TLS ask) is called by Caddy over the compose
	# network and must never be reachable from the internet. It is unauthenticated by design, and
	# its throttle is keyed on the REQUESTED DOMAIN — which turned it into an anonymous kill-switch:
	# 10 requests/min for someone else's white-label hostname makes the ask return 429, Caddy reads
	# any non-2xx as "deny", and that tenant's certificate stops being issued or renewed. The 200/403
	# split is also an unauthenticated oracle for which hostnames are verified. Audit high.
	handle /v1/internal/* {
		respond 404
	}
	handle /v1/* {
		# /v1/* includes the WS upgrade at /v1/stream — the API rejects any other /ws path
		reverse_proxy api:3010
	}
	handle {
		reverse_proxy web:5173
	}
}

# ── Tenant custom domains (staging/prod) ─────────────────────────────────────
# Any hostname NOT matched above gets a cert on demand (gated by the ask above),
# then proxies to web (SPA) with /v1 carved out to the api (the /v1/stream WS upgrade
# rides /v1/*). The SPA reads GET /v1/branding (Host-based) for the pre-login logo/colors.
# This block self-activates whenever Caddy publishes :443 — left inert locally (the infra-only
# compose maps :443→8449 and has no real DNS). There is NO ORBETRA_PUBLIC switch: that variable
# is referenced nowhere in this file and nothing passes it to the container.
# NOTE: requires `api` and `web` services reachable on this network — present in the staging
# app layer (docker-compose.apps.yml), absent in the local infra-only compose.
https:// {
	tls {
		on_demand
	}
	# Security headers at the edge (E07-5). Site-wide, so /v1 responses carry them TWICE
	# (edge + the api's own set — defense in depth). Duplicates are harmless while the two
	# layers stay IDENTICAL; if you change a value here, change apps/api/src/security.ts
	# too (conflicting XFO/STS duplicates confuse browsers). The SPA is never embedded,
	# so framing is denied outright.
	#
	# NO `includeSubDomains` on THIS block, unlike our own hosts. These are domains we do not
	# own: asserting a 180-day HTTPS-only policy across a customer's whole namespace would lock
	# their mail interface, their VPN portal and any legacy HTTP tooling out of every visitor's
	# browser for six months, and there is no way to unwind it remotely. If a tenant ever points
	# an apex here, that is their entire company.
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# INTERNAL-ONLY (see the app host block): the on-demand-TLS ask must not be reachable here
	# either — a tenant custom domain is exactly where an attacker would look for it.
	handle /v1/internal/* {
		respond 404
	}
	# PLATFORM SURFACES, 404'd on a tenant's own domain. Each of these answered here and each
	# named us to the tenant's customers:
	#   /v1/docs + /v1/openapi.json — a page titled "Orbetra API" listing every platform route
	#     AND `servers: [https://dash.orbetra.com]`, unauthenticated, on fleet.reseller.lt;
	#   /v1/public/signup — a stranger on the reseller's domain could create a tenant on OUR
	#     platform; /v1/public/pilot-request files a lead into OUR sales inbox;
	#   /v1/partner/* — the affiliate portal, which belongs to us, not to them.
	# The manifest is the one /v1/public path that MUST answer here: it is this host's app name.
	handle /v1/docs* {
		respond 404
	}
	handle /v1/openapi.json {
		respond 404
	}
	handle /v1/public/signup {
		respond 404
	}
	handle /v1/public/pilot-request {
		respond 404
	}
	handle /v1/partner/* {
		respond 404
	}
	# API + realtime first (longest-prefix wins in Caddy route ordering).
	# /v1/* includes the WS upgrade at /v1/stream — the API rejects any other /ws path.
	handle /v1/* {
		reverse_proxy api:3010
	}
	# everything else is the SPA
	handle {
		reverse_proxy web:5173
	}
}
