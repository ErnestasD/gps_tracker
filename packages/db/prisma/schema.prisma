// Orbetra relational schema (E01-3). PROJECT_PLAN §6.3.
// `positions` is deliberately NOT here — hypertable lives in packages/db/sql/ and is
// raw-SQL-only territory (CLAUDE.md rule 1, ADR-003 boundary).
// Column design derived from spec references; see docs/epics/E01-3-plan.md ambiguity note.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  platform_admin
  tsp_admin
  account_manager
  viewer
}

/// Tenant plan (entitlement axis, orthogonal to Role). MUST mirror @orbetra/shared TENANT_PLANS
/// (packages/shared/src/plans.ts) — asserted by packages/shared/__tests__/plans.spec.ts.
enum TenantPlan {
  direct_5
  direct_10
  direct_25
  direct_50
  direct_100
  tsp_start
  tsp_grow
  tsp_scale
  tsp_enterprise
}

enum CommandStatus {
  queued
  sent
  acked
  failed
  expired
}

enum SmsStatus {
  queued
  sent
  failed
}

enum TripStatus {
  open
  closed
}

enum GeofenceKind {
  polygon
  circle
  corridor
}

enum RuleKind {
  geofence
  overspeed
  ignition
  din_change
  power_cut
  low_battery
  panic
  device_offline
  fuel_theft
}

enum OdometerSource {
  auto
  device
  gps
}

model Tenant {
  id                    String     @id @default(uuid()) @db.Uuid
  name                  String
  /// white-label: { logoUrl, primary, accent, productName, supportEmail } (E03-5)
  branding              Json       @default("{}")
  /// tenant plan / entitlement tier (founder decision 2026-07-20). Existing tenants default to
  /// tsp_grow (preserves all current behavior). Set by the signature-verified Stripe webhook for
  /// self-service Direct, or by platform_admin for sales-led TSP. NEVER browser-trusted.
  plan                  TenantPlan @default(tsp_grow)
  /// set once from pilot-lead ref, immutable afterwards (§6.9)
  referredByAffiliateId String?    @db.Uuid
  /// Stripe billing (ADR-024). Set lazily on first checkout; subscription state is written
  /// ONLY by the signature-verified webhook, never by the browser.
  stripeCustomerId      String?    @unique
  stripeSubscriptionId  String?
  /// the subscribed BASE price id (which plan) — drives the usage reporter's included-device lookup (PR B2)
  subscriptionPriceId   String?
  /// mirrors Stripe's subscription.status (active|trialing|past_due|canceled|unpaid|…); null = never subscribed
  subscriptionStatus    String?
  currentPeriodEnd      DateTime?  @db.Timestamptz()
  /// timestamp of the last APPLIED Stripe event; a webhook update lands only when strictly newer
  /// (monotonic guard against out-of-order/duplicate delivery — ADR-024)
  lastBillingEventAt    DateTime?  @db.Timestamptz()
  /// id (`evt_…`) of the last APPLIED Stripe event. Diagnostic only — redelivery suppression lives
  /// in {@link BillingEvent}, because a single slot forgets everything but the previous event.
  lastBillingEventId    String?
  /// rank of that event's TYPE (created 0 < updated 1 < deleted 2) — the deterministic order WITHIN
  /// one `event.created` second. Stripe does not guarantee delivery order, and `event.created` is
  /// second-granularity, so without this a `.deleted` followed by a reordered `.updated` would undo
  /// a cancel and hand a canceled customer full paid service (audit #25).
  lastBillingEventRank  Int?
  /// affiliate commission window: the tenant's FIRST paid invoice, and the affiliate's
  /// `commissionMonths` AS IT STOOD at that moment. Both are snapshots — the window used to be
  /// derived from the earliest COMMISSION ROW and a live `commissionMonths`, so a period in which
  /// nothing accrued moved the anchor forward, and an admin edit re-opened closed windows (audit #26).
  commissionAnchorAt       DateTime? @db.Timestamptz()
  commissionMonthsAtAnchor Int?
  /// When the tenant's devices were torn out of the ingest registry for non-payment (audit MED #22).
  /// NULL = serving normally. Suspension stops NEW data being accepted; it deletes nothing, the
  /// customer can still sign in and read their history, and paying restores the feed within one
  /// webhook.
  suspendedAt              DateTime? @db.Timestamptz()
  /// Which lapse notice has already gone out: 0 none, 1 grace-end, 2 day+1, 3 day+2 (final). The
  /// daily sweep is idempotent on this — a job that runs twice, or a worker restarted mid-sweep,
  /// must not mail the same customer twice nor skip the final warning before cutting them off.
  lapseNoticeStage         Int       @default(0)
  /// The `lapsedAt` the stage above belongs to. A stage recorded against a DIFFERENT lapse counts as
  /// zero, which is what stops a customer who paid before being cut off from being suspended with no
  /// warnings the next time they lapse.
  lapseNoticeFor           DateTime? @db.Timestamptz()
  createdAt             DateTime   @default(now()) @db.Timestamptz()

  accounts            Account[]
  users               User[]
  domains             TenantDomain[]
  scheduledReports    ScheduledReport[]
  pushSubscriptions   PushSubscription[]
  /// affiliate attribution (W9): the partner who referred this tenant, set once at signup from ?ref
  referredByAffiliate Affiliate?         @relation("AffiliateReferrals", fields: [referredByAffiliateId], references: [id])
  /// the admin registry aggregates referred tenants per partner, and the accrual path resolves a
  /// tenant's referrer on every paid invoice — both were unindexed scans (migration 20260808070000)
  @@index([referredByAffiliateId])
  commissions         Commission[]       @relation("TenantCommissions")
  usageReports        UsageReport[]

  @@map("tenants")
}

/// Affiliate/partner program (W9). Invite-only in v1: platform_admin creates the affiliate, which
/// gets a unique referral code. A tenant signing up via ?ref=code is attributed here, and recurring
/// commissions accrue on that tenant's subscription payments for `commissionMonths` at `commissionPct`.
enum AffiliateStatus {
  pending
  active
  suspended
}

model Affiliate {
  id               String          @id @default(uuid()) @db.Uuid
  name             String
  email            String          @unique
  /// the referral code embedded in the partner's link (?ref=CODE) — unique, case-insensitive by convention
  code             String          @unique
  /// recurring commission as a percent of the referred tenant's subscription payment (e.g. 20.00)
  commissionPct    Decimal         @default(20) @db.Decimal(5, 2)
  /// how many months the recurring commission is paid, counted from the referred tenant's first payment
  commissionMonths Int             @default(12)
  status           AffiliateStatus @default(pending)
  createdAt        DateTime        @default(now()) @db.Timestamptz()
  /// argon2id hash for the partner self-service login (F5); null until the partner sets a password
  passwordHash     String?

  referrals   Tenant[]                 @relation("AffiliateReferrals")
  commissions Commission[]
  clicks      AffiliateClick[]
  pwTokens    AffiliatePasswordToken[]

  @@map("affiliates")
}

/// One-time token for a partner to SET (initial) or RESET their self-service password (F5). Mirrors
/// PasswordResetToken: only the SHA-256 hash is stored, single-use, expiring. An admin issues one and
/// conveys the link to the partner (email wiring is a follow-up).
model AffiliatePasswordToken {
  id          String    @id @default(uuid()) @db.Uuid
  affiliateId String    @db.Uuid
  tokenHash   String    @unique
  expiresAt   DateTime  @db.Timestamptz()
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  /// set when the token is consumed by a successful set/reset (single-use)
  usedAt      DateTime? @db.Timestamptz()

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("affiliate_password_tokens")
}

enum CommissionStatus {
  /// accrued, not yet paid out to the affiliate
  pending
  /// marked paid by an admin (actual transfer is external)
  paid
  /// reversed (e.g. the customer refunded / charged back)
  void
}

/// Daily UNIQUE clicks on a partner's short link (`/r/<code>`), §6.9 funnel.
///
/// One row per partner per UTC day, incremented in place — a click is not an event worth storing
/// individually, and a row-per-click table on a public unauthenticated URL is an invitation to fill
/// the disk. "Unique" means one visitor (IP, per code, per day) counts once: a partner wants to know
/// how many PEOPLE opened their link, and a raw hit count that a single refresh inflates is a number
/// they will stop trusting.
model AffiliateClick {
  affiliateId String    @db.Uuid
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// UTC calendar day — the ledger next to it is UTC too, so the funnel does not shift by timezone
  day         DateTime  @db.Date
  clicks      Int       @default(0)

  @@id([affiliateId, day])
  @@map("affiliate_clicks")
}

model Commission {
  id              String           @id @default(uuid()) @db.Uuid
  affiliateId     String           @db.Uuid
  affiliate       Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Restrict)
  tenantId        String           @db.Uuid
  /// the referred tenant whose payment generated this commission
  tenant          Tenant           @relation("TenantCommissions", fields: [tenantId], references: [id], onDelete: Restrict)
  /// commission amount in MINOR units (cents), same currency as the source customer payment
  amountCents     Int
  currency        String           @default("eur")
  /// the Stripe invoice this was accrued from — UNIQUE so a webhook retry can't double-accrue (idempotency)
  sourceInvoiceId String           @unique
  status          CommissionStatus @default(pending)
  createdAt       DateTime         @default(now()) @db.Timestamptz()
  /// the commission rate AGREED AT ACCRUAL — snapshotted so editing the affiliate never re-prices history (§6.9)
  ratePct         Decimal?         @db.Decimal(5, 2)
  /// the customer payment this was computed from, in minor units (the `amount_paid` of the source invoice)
  baseAmountCents Int?
  /// when the source invoice was actually PAID (Stripe's clock) — the earning window anchors on the
  /// tenant's earliest paidAt, not on a row's DB insert time
  paidAt          DateTime?        @db.Timestamptz()

  @@index([affiliateId, status])
  @@map("commissions")
}

model TenantDomain {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  domain    String
  /// true after the DNS TXT verification job; Caddy ask endpoint checks this (E03-5)
  verified  Boolean  @default(false)
  txtToken  String
  createdAt DateTime @default(now()) @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Global uniqueness applies ONLY to VERIFIED domains — enforced by a partial unique
  // index added in migration SQL (Prisma can't express `WHERE verified`). First tenant
  // to prove DNS ownership wins; a pending squat can't block the real owner from
  // adding+verifying. Pending rows are unique per tenant only (composite below).
  @@unique([tenantId, domain])
  @@index([tenantId])
  @@map("tenant_domains")
}

model Account {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  /// IANA zone; ALL rendering converts from UTC with this (CLAUDE.md rule 7)
  timezone  String   @default("UTC")
  /// Language + units for everything the SERVER renders for this fleet: alert e-mails, Telegram
  /// messages and scheduled report tables.
  ///
  /// They live on the ACCOUNT, not on the user, because the recipients have no user row. A rule's
  /// notification channel targets a free-text address (`dispatcher@customer.lt`, a shared inbox, an
  /// on-call alias) and a scheduled report carries a `recipients[]` array of the same; there is
  /// simply nobody to read a preference from. The account IS the fleet — one operation, one country,
  /// one set of units — which is the same reason `timezone` above is already an account column.
  ///
  /// The browser keeps its own SEPARATE device-local copy (localStorage) for what IT draws: a
  /// formatter cannot wait for a round trip, and one person may prefer miles on their own screen.
  /// The two are independent by design and CAN differ — a dashboard in km beside a report in mi is a
  /// legitimate choice. What must not happen is that difference being invisible, so Settings shows
  /// both panels together and each says which surface it governs.
  locale       String @default("en")
  /// 'kmh' | 'mph' — validated by the API (speedUnitSchema); a value this build does not know falls
  /// back to metric at render rather than throwing inside an e-mail.
  unitSpeed    String @default("kmh")
  /// 'km' | 'mi'
  unitDistance String @default("km")
  /// 'l' | 'gal'
  unitVolume   String @default("l")
  createdAt DateTime @default(now()) @db.Timestamptz()

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  devices           Device[]
  scheduledReports  ScheduledReport[]
  pushSubscriptions PushSubscription[]

  @@index([tenantId])
  @@map("accounts")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  /// null ⇒ tenant-level user (tsp_admin); set ⇒ scoped to one account
  accountId         String?   @db.Uuid
  email             String
  passwordHash      String
  role              Role
  locale            String    @default("en")
  createdAt         DateTime  @default(now()) @db.Timestamptz()
  /// Session epoch: every credential minted BEFORE this instant is dead. Written by the eviction
  /// paths (password change/reset, admin role or scope change, user delete) in the SAME transaction
  /// that revokes the refresh rows, and read under `FOR UPDATE` by refresh rotation — that lock is
  /// what serializes the two, so an eviction can never be invisible to a rotation in flight.
  sessionsRevokedAt DateTime? @db.Timestamptz()
  /// When the address was PROVEN to belong to this person. NULL ⇒ the account cannot authenticate.
  ///
  /// Only PUBLIC self-serve signup ever writes NULL. Every other creation path — an admin adding a
  /// colleague, the demo seed — is vouched for by an already-authenticated actor and is verified on
  /// creation, so this cannot lock anyone out of a tenant that already works.
  ///
  /// It exists because signup must not be an account-existence oracle (audit MED #67). Returning the
  /// same 201 for a taken and a free address is not enough on its own: while the free path handed
  /// back a working account, a second request — a login with the password the caller just chose —
  /// still answered the question with certainty. An unverified account fails login exactly like a
  /// wrong password, so both branches now end in the same 401 and the question has no answer.
  /// DB-side `DEFAULT now()` (matches the migration): during a rolling deploy the OLD api writes to
  /// the NEW schema, and those users would otherwise land NULL and be locked out. Self-serve signup
  /// sends the column explicitly as null, so the default never reaches the path that must stay
  /// unverified.
  emailVerifiedAt   DateTime? @default(dbgenerated("now()")) @db.Timestamptz()

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                 Account?                 @relation(fields: [accountId], references: [id], onDelete: SetNull)
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pushSubscriptions       PushSubscription[]

  @@unique([tenantId, email])
  @@index([accountId])
  /// login is cross-tenant (email may exist in N tenants) — the composite unique
  /// can't serve an email-only lookup, so index email alone (E03-1, review LOW)
  @@index([email])
  @@map("users")
}

/// Rotating refresh-token families (E03-1, §6.6): raw token = 32B CSPRNG, only its
/// sha256 stored (deterministic unique lookup; 256-bit entropy makes offline brute
/// force moot — same rationale as ApiKey.hash). familyId = id of the family's first
/// token; reuse of a rotated token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  familyId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  /// set when consumed to mint a successor (rotation)
  rotatedAt DateTime? @db.Timestamptz()
  /// set by logout / family revocation on reuse detection
  revokedAt DateTime? @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

/// One-time password-reset tokens (forgot-password flow): raw token = 32B CSPRNG,
/// only its sha256 stored (same rationale as RefreshToken.tokenHash — 256-bit entropy
/// makes offline brute force moot). Single-use (usedAt) and short-lived (expiresAt, 1 h).
/// Rows are addressed only by tokenHash; a successful reset consumes the token AND
/// invalidates the user's other outstanding tokens.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  /// set when the token is consumed by a successful reset (single-use)
  usedAt    DateTime? @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Single-use, expiring proof that a self-serve signup owns the address it registered (audit MED
/// #67). Mirrors PasswordResetToken exactly — only the SHA-256 hash is stored, so a database read
/// cannot activate an account; the raw token exists only in the one email.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz()
  createdAt DateTime  @default(now()) @db.Timestamptz()
  /// set when the token is consumed by a successful verification (single-use)
  usedAt    DateTime? @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model DeviceProfile {
  id             String @id @default(uuid()) @db.Uuid
  /// seed keys: fmb1xx, fmc, fmb6xx-stub, tat-asset (E03-3)
  key            String @unique
  name           String
  /// trip/presence thresholds (§6.4); offline sweeper reads these (§6.5)
  presenceRules  Json   @default("{}")
  commandPresets Json   @default("[]")
  /// ingest read-idle timeout, minutes (§6.1 top)
  readIdleMin    Int    @default(40)

  devices Device[]

  @@map("device_profiles")
}

model Device {
  id             BigInt         @id @default(autoincrement())
  tenantId       String         @db.Uuid
  accountId      String         @db.Uuid
  profileId      String         @db.Uuid
  /// 15-digit string — leading zeros preserved (E03-3 edge case)
  /// Unique among ACTIVE devices only — a partial unique index lives in SQL (migration
  /// 20260805150000), because Prisma cannot express `WHERE "retiredAt" IS NULL`. Retiring frees the
  /// IMEI so the SAME tenant can re-register returned hardware; `devices.create` refuses a reclaim
  /// by any OTHER tenant, because the tracker may still be wired up and transmitting. A plain
  /// lookup index lives in migration 20260805160000 (a partial index cannot serve these queries).
  imei           String
  name           String
  plate          String?
  groupName      String?
  /// SIM MSISDN (E.164, e.g. +37060000000) — the phone number config SMS are sent TO (SMS gateway)
  simMsisdn      String?
  /// SIM ICCID (18–22 digits) — operator-entered SIM serial, informational
  simIccid       String?
  odometerSource OdometerSource @default(auto)
  retiredAt      DateTime?      @db.Timestamptz()
  createdAt      DateTime       @default(now()) @db.Timestamptz()

  account          Account           @relation(fields: [accountId], references: [id])
  profile          DeviceProfile     @relation(fields: [profileId], references: [id])
  shareLinks       ShareLink[]
  maintenanceItems MaintenanceItem[]

  @@index([tenantId, accountId])
  // plain lookup index (migration 20260805160000). Declared HERE so `prisma migrate dev` does not
  // drop it: the partial UNIQUE index cannot serve a query that omits `WHERE "retiredAt" IS NULL`,
  // and neither IMEI lookup does — without this one, `imeisIn` seq-scans on the pipeline's pool.
  @@index([imei])
  @@map("devices")
}

/// Temporary public share link (V1-nice) — an expiring, revocable URL exposing ONE device's
/// live position with no login. Token stored as SHA-256 hash + short prefix (like ApiKey,
/// E06-3); plaintext returned once. Expiry + revoke are enforced in the resolve query.
model ShareLink {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  /// copied from the device at creation so account-scoped users see only their own links
  accountId       String    @db.Uuid
  deviceId        BigInt
  /// SHA-256 of the opaque token — the plaintext is never stored
  tokenHash       String    @unique
  /// short display prefix (first chars) for the management list
  tokenPrefix     String
  label           String?
  createdByUserId String    @db.Uuid
  expiresAt       DateTime  @db.Timestamptz()
  revokedAt       DateTime? @db.Timestamptz()
  createdAt       DateTime  @default(now()) @db.Timestamptz()

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([deviceId])
  @@map("share_links")
}

/// Driver registry (V2). Account-scoped. `ibutton` is the driver's physical iButton/RFID key id
/// (hex) — stored so a follow-up can resolve a tap (AVL iButton) to a driver and stamp the trip.
/// iButton is unique WITHIN a tenant (NULLs are distinct in Postgres → many keyless drivers ok).
model Driver {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  accountId String   @db.Uuid
  name      String
  licenseNo String?
  ibutton   String?
  phone     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz()

  trips Trip[]

  @@unique([tenantId, ibutton])
  @@index([tenantId, accountId])
  @@map("drivers")
}

/// Maintenance schedule item (V2). Per-device service reminder by odometer km and/or elapsed days.
/// Due is computed at READ time from the device's current odometer + now (not stored). Account-scoped.
model MaintenanceItem {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  accountId        String    @db.Uuid
  deviceId         BigInt
  title            String
  intervalKm       Int?
  intervalDays     Int?
  lastServiceOdoKm Int?
  lastServiceAt    DateTime? @db.Timestamptz()
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz()

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId])
  @@index([deviceId])
  @@map("maintenance_items")
}

model RawReject {
  id        BigInt   @id @default(autoincrement())
  imei      String?
  /// resolved by the drain from the IMEI; null on rows written before the column existed. GDPR
  /// erase keys on THIS — by IMEI it would reach a different device's rows, since an IMEI is only
  /// unique among ACTIVE devices (migration 20260805150000).
  deviceId  BigInt?
  reason    String
  payload   Bytes?
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([createdAt])
  // both are used: deviceId by the erase, imei by the legacy fallback and by support lookups
  @@index([imei])
  @@index([deviceId])
  @@map("raw_rejects")
}

model Trip {
  id             BigInt     @id @default(autoincrement())
  tenantId       String     @db.Uuid
  accountId      String     @db.Uuid
  deviceId       BigInt
  status         TripStatus
  startTime      DateTime   @db.Timestamptz()
  endTime        DateTime?  @db.Timestamptz()
  startLat       Float?
  startLon       Float?
  endLat         Float?
  endLon         Float?
  distanceM      Int        @default(0)
  /// 'odometer' | 'gps' — surfaced in UI/reports (E04-5)
  distanceSource String     @default("gps")
  maxSpeed       Int        @default(0)
  idleS          Int        @default(0)
  /// driver on this trip (V2) — assigned manually or resolved from the iButton tap (follow-up).
  /// SET NULL on driver delete so trip history survives (never a dangling FK).
  driverId       String?    @db.Uuid
  createdAt      DateTime   @default(now()) @db.Timestamptz()

  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([deviceId, startTime])
  @@index([tenantId, accountId, startTime])
  // supports the drivers→trips ON DELETE SET NULL cascade + driver-filtered lookups. Declared here
  // to match the index created in migration 20260714130000_trip_driver (schema/migration drift fix).
  @@index([driverId])
  // PARTIAL index on the open set (migration 20260804170000_trips_open_index) — Prisma cannot
  // express a WHERE clause, so it is declared in SQL and noted here to document the drift.
  @@map("trips")
}

model Geofence {
  id        String                                 @id @default(uuid()) @db.Uuid
  tenantId  String                                 @db.Uuid
  /// null ⇒ visible to all accounts of the tenant (E05-1 accounts scope)
  accountId String?                                @db.Uuid
  name      String
  color     String                                 @default("#4DA3FF")
  kind      GeofenceKind
  /// raw accessors only (ST_GeomFromGeoJSON etc, E05-1); area guard ≤ 10,000 km²
  geom      Unsupported("geography(Polygon,4326)")
  createdAt DateTime                               @default(now()) @db.Timestamptz()

  @@index([tenantId, accountId])
  @@map("geofences")
}

model Rule {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  accountId String   @db.Uuid
  kind      RuleKind
  name      String
  /// kind-specific config: thresholds, geofenceId, …
  config    Json     @default("{}")
  /// device/group scope selector (E05-3)
  scope     Json     @default("{}")
  /// notification channels: email/telegram/webhook refs (E05-4)
  channels  Json     @default("[]")
  cooldownS Int      @default(300)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, accountId, enabled])
  @@map("rules")
}

model Event {
  id             BigInt    @id @default(autoincrement())
  tenantId       String    @db.Uuid
  accountId      String    @db.Uuid
  deviceId       BigInt
  ruleId         String?   @db.Uuid
  kind           String
  at             DateTime  @db.Timestamptz()
  lat            Float?
  lon            Float?
  payload        Json      @default("{}")
  acknowledgedAt DateTime? @db.Timestamptz()
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  @@index([tenantId, accountId, at])
  @@index([deviceId, at])
  // the alerts feed paginates ORDER BY id DESC under a (tenantId, accountId) filter — the `at`
  // index can't serve an id-ordered keyset scan, so add one that matches filter+order (perf, review MED)
  @@index([tenantId, accountId, id])
  @@map("events")
}

model Command {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  accountId String        @db.Uuid
  deviceId  BigInt
  text      String
  status    CommandStatus @default(queued)
  response  String?
  createdAt DateTime      @default(now()) @db.Timestamptz()
  sentAt    DateTime?     @db.Timestamptz()
  /// §3.5: expire after 24 h
  expiresAt DateTime      @db.Timestamptz()

  @@index([deviceId, status])
  @@index([tenantId, accountId, createdAt])
  @@map("commands")
}

/// SMS gateway delivery audit (SMS gateway feature). One row per outbound SMS to a device's SIM.
/// V1 uses the platform-default Twilio driver only (provider defaults 'twilio'); per-tenant creds
/// are a follow-up. The worker drives status queued→sent|failed and stamps providerMessageId.
model SmsDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  accountId         String    @db.Uuid
  deviceId          BigInt
  to                String
  body              String
  provider          String    @default("twilio")
  providerMessageId String?
  status            SmsStatus @default(queued)
  error             String?
  createdAt         DateTime  @default(now()) @db.Timestamptz()
  sentAt            DateTime? @db.Timestamptz()

  @@index([deviceId, status])
  @@index([tenantId, accountId, createdAt])
  @@map("sms_deliveries")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  accountId  String?   @db.Uuid
  name       String
  /// orb_live_<8 chars> shown in UI; full key never stored (E06-3)
  prefix     String
  /// SHA-256 of the full key
  hash       String    @unique
  scopes     String[]  @default(["read"])
  lastUsedAt DateTime? @db.Timestamptz()
  revokedAt  DateTime? @db.Timestamptz()
  createdAt  DateTime  @default(now()) @db.Timestamptz()

  @@index([tenantId])
  @@map("api_keys")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  accountId String?  @db.Uuid
  url       String
  /// HMAC-SHA256 signing secret (§6.5); rotation = new row + 24 h dual-sign (E06-4)
  secret    String
  events    String[] @default([])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, enabled])
  @@map("webhooks")
}

/// Scheduled emailed reports (V1-nice). The worker's hourly cron runs the report over the account's
/// data at the configured UTC hour (daily, or weekly on `weekday`) and e-mails it to `recipients`.
/// The report window is computed in `timezone` (account-local day boundaries, §7.7).
model ScheduledReport {
  // DB-side default (matches migration 20260715030000) — @default(uuid()) is client-side only and
  // would make the next `prisma migrate dev` emit a spurious DROP DEFAULT (schema/migration drift fix).
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  accountId  String    @db.Uuid
  reportType String
  /// 'daily' | 'weekly'
  cadence    String
  /// hour of day (UTC, 0–23) the cron fires the report
  hourUtc    Int
  /// 0=Sunday … 6=Saturday, only for cadence='weekly'
  weekday    Int?
  recipients String[]  @default([])
  timezone   String    @default("UTC")
  enabled    Boolean   @default(true)
  lastRunAt  DateTime? @db.Timestamptz()
  createdAt  DateTime  @default(now()) @db.Timestamptz()

  // FKs, added 2026-08-05 (audit MED). Without them a deleted tenant or account left its schedules
  // behind, and the worker's hourly cron kept running the report and E-MAILING an ex-customer's
  // recipients — data about an account that no longer exists, with no API surface to stop it
  // (every read is scoped by tenant, so the row was invisible to the product).
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([enabled])
  @@index([tenantId])
  @@index([accountId])
  @@map("scheduled_reports")
}

/// Browser push subscriptions (Web Push, ADR-026). One row per subscribed browser; a `webpush` rule
/// channel fans out to the account's rows. `endpoint` is globally unique (the push-service URL).
model PushSubscription {
  // DB-side default (matches migration 20260716120000) — see ScheduledReport.id (schema/migration drift fix).
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  accountId String   @db.Uuid
  userId    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @db.Timestamptz()

  // FKs, added 2026-08-05 (audit MED). A `webpush` rule channel fans out to the ACCOUNT's rows, so
  // a subscription that outlived its user kept pushing that account's alerts — vehicle positions and
  // geofence events — to a removed employee's browser, for as long as the browser kept the
  // subscription alive. Cascading on the USER is the important one: deleting the person is the
  // action an operator takes, and it must take their devices' notifications with it.
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId])
  @@index([accountId])
  @@index([userId])
  @@map("push_subscriptions")
}

/// Webhook delivery attempts (E06-4b) — one row per POST attempt for observability/debugging.
/// Written by the worker (raw SQL); read-only over the API. Retention pruning is W7.
model WebhookDelivery {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @db.Uuid
  accountId  String?  @db.Uuid
  webhookId  String   @db.Uuid
  eventId    String
  kind       String
  /// HTTP status if a response arrived; null on a network error / timeout / blocked URL
  statusCode Int?
  success    Boolean
  /// short failure reason (never the payload/secret)
  error      String?
  at         DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, at])
  @@index([webhookId, at])
  // bare `at` supports the retention prune (WHERE at < cutoff, no tenant/webhook constraint)
  @@index([at])
  // deliveries list paginates ORDER BY id DESC under the (tenantId, accountId) scope — match
  // filter+order for a keyset scan instead of an id-pk backward walk (perf, review LOW)
  @@index([tenantId, accountId, id])
  @@map("webhook_deliveries")
}

/// GDPR account data export job (E08-4). File lands in EXPORT_DIR; download is scoped +
/// expires (410 after expiresAt). R2/S3 upload is a follow-up when creds exist.
model ExportJob {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  accountId String   @db.Uuid
  status    String   @default("pending") // pending | done | failed
  /// absolute path of the .json.gz once done (never exposed to clients)
  path      String?
  sizeBytes BigInt?
  error     String?
  createdAt DateTime @default(now()) @db.Timestamptz()
  expiresAt DateTime @db.Timestamptz()

  @@index([tenantId, createdAt])
  @@map("export_jobs")
}

/// Pilot-request lead from the public site (W9-S1, §6.9). UNSCOPED table — leads
/// precede tenants; readable by platform_admin only.
model Lead {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  company     String
  email       String
  phone       String?
  deviceCount String?
  message     String?
  /// affiliate code from the tc_ref cookie (§6.9 last-touch)
  ref         String?
  createdAt   DateTime @default(now()) @db.Timestamptz()

  @@index([createdAt])
  @@map("leads")
}

model UsageDaily {
  tenantId  String   @db.Uuid
  accountId String   @db.Uuid
  deviceId  BigInt
  day       DateTime @db.Date
  active    Boolean  @default(true)

  @@id([deviceId, day])
  @@index([tenantId, day])
  @@map("usage_daily")
}

/// What has ALREADY been reported to Stripe's overage meter, per tenant-day (audit MED #21).
///
/// `reported` is CUMULATIVE — the total overage-device count Stripe has been told about for that day,
/// not the last delta. The reporter re-walks a trailing window each run and submits `over − reported`,
/// so a failed run, a restart, or a device that flushed its offline buffer after midnight is picked up
/// by the next run instead of being lost. Without this row the job had exactly one chance per day and
/// no way to know whether it took it.
model UsageReport {
  tenantId   String   @db.Uuid
  day        DateTime @db.Date
  reported   Int
  /// the plan's included-device allowance AT THE TIME this day was reported. The reporter re-walks
  /// past days, so without it a downgrade (750 included → 200) would recompute last week's overage
  /// against the smaller allowance and bill hundreds of device-days the customer never owed.
  included   Int?
  /// the base price the day was settled under — the discriminator between "the plan changed" (freeze
  /// the day as billed) and "STRIPE_INCLUDED was corrected" (recompute it). Freezing on the allowance
  /// alone made a config typo permanently unbillable, which is the opposite of audit #23's intent.
  priceId    String?
  reportedAt DateTime @default(now()) @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, day])
  @@map("usage_reports")
}

/// Stripe events already APPLIED, for durable redelivery suppression (audit MED #25).
///
/// Not keyed on the tenant on purpose: the question it answers is "have I applied this event id",
/// independently of what any tenant row now holds. The tenant's `lastBillingEventId` cannot answer
/// it — it remembers one event, so `updated → deleted → retry of updated` (an ordinary Stripe retry
/// after a lost response) looked like a new event and resurrected a canceled subscription.
model BillingEvent {
  eventId   String   @id
  type      String
  eventAt   DateTime @db.Timestamptz()
  appliedAt DateTime @default(now()) @db.Timestamptz()

  @@index([appliedAt])
  @@map("billing_events")
}

model AuditLog {
  id       BigInt   @id @default(autoincrement())
  tenantId String?  @db.Uuid
  userId   String?  @db.Uuid
  action   String
  entity   String
  entityId String
  before   Json?
  after    Json?
  at       DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, at])
  // audit UI paginates ORDER BY id DESC filtered by tenantId — match filter+order (perf, review LOW)
  @@index([tenantId, id])
  @@map("audit_log")
}

model GeocodeCache {
  /// geohash7 ≈ 150 m cell (§6.3)
  gridKey    String   @id
  address    String
  resolvedAt DateTime @default(now()) @db.Timestamptz()

  @@map("geocode_cache")
}
